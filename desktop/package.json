{
  "name": "hadith-desktop",
  "productName": "Hadith",
  "version": "0.2.0",
  "description": "الجامع — موسوعة الحديث (hadith.dev) لسطح المكتب",
  "homepage": "https://hadith.dev",
  "author": "hadith.dev",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "hadithOffline": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:store": "electron-builder --win appx --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.18.0"
  }
}
